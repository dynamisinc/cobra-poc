{
  "// README": "See docs/TEAMS_BOT_SETUP.md for complete setup instructions",

  "// Instructions": [
    "1. Copy this file to appsettings.Development.json (which is git-ignored)",
    "2. Create App Registration in Azure Portal (see docs/TEAMS_BOT_SETUP.md)",
    "3. Create Azure Bot resource (Type: Single Tenant, use existing app registration)",
    "4. Replace placeholders below with your values",
    "",
    "IMPORTANT CONFIGURATION NOTES:",
    "- App Registration MUST be Multi-Tenant (for cross-org support)",
    "- Azure Bot Type will be Single Tenant (can't be changed after creation)",
    "- Use YOUR_BOT_TENANT_ID (where bot is registered), NOT target tenant",
    "- ConnectionsMap is REQUIRED for proactive messaging (COBRA -> Teams)",
    "- API Permissions: Add Microsoft Graph > User.Read and grant admin consent"
  ],

  "// Configuration for Single-Tenant Bot + Multi-Tenant App Registration": [
    "This is the RECOMMENDED configuration for multi-org bots.",
    "Multi-Tenant Bot Type is deprecated after July 31, 2025."
  ],

  "MicrosoftAppType": "SingleTenant",
  "MicrosoftAppId": "YOUR_AZURE_BOT_APP_ID",
  "MicrosoftAppPassword": "YOUR_AZURE_BOT_CLIENT_SECRET",
  "MicrosoftAppTenantId": "YOUR_BOT_TENANT_ID",

  "TokenValidation": {
    "Enabled": false
  },

  "// Connections": "OAuth configuration for proactive messaging. Uses same credentials as above.",
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "ClientId": "YOUR_AZURE_BOT_APP_ID",
        "ClientSecret": "YOUR_AZURE_BOT_CLIENT_SECRET",
        "AuthorityEndpoint": "https://login.microsoftonline.com/YOUR_BOT_TENANT_ID",
        "Scopes": ["https://api.botframework.com/.default"]
      }
    }
  },

  "// ConnectionsMap": "CRITICAL: Maps service URLs to auth connections. Required for proactive messaging!",
  "ConnectionsMap": [
    { "ServiceUrl": "*", "Connection": "ServiceConnection" }
  ],

  "Bot": {
    "DisplayName": "COBRA Teams Bot",
    "Description": "COBRA Event Management Bot for emergency coordination"
  },

  "CobraApi": {
    "BaseUrl": "http://localhost:5000",
    "ApiKey": "dev-teams-bot-key-12345"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents": "Debug"
    }
  },

  "AllowedHosts": "*",

  "// Placeholders to Replace": {
    "YOUR_AZURE_BOT_APP_ID": "App Registration > Overview > Application (client) ID",
    "YOUR_AZURE_BOT_CLIENT_SECRET": "App Registration > Certificates & secrets > Client secret value",
    "YOUR_BOT_TENANT_ID": "App Registration > Overview > Directory (tenant) ID"
  },

  "// Troubleshooting": [
    "401 'missing service principal': Use YOUR bot's tenant ID, not target tenant",
    "401 'token rejected': Ensure Azure Bot Type matches config (both SingleTenant)",
    "'No connections map found': ConnectionsMap section is missing or malformed",
    "'Settings not found': Connections.ServiceConnection.Settings is misconfigured",
    "See docs/TEAMS_BOT_TROUBLESHOOTING.md for more help"
  ]
}
